[$XDG_CONFIG_HOME/vcsh/repo.d/awscli.git]
checkout =
    vcsh clone 'https://github.com/zxiiro/dotfiles-awscli.git' 'awscli'
update   = vcsh awscli pull
push     =
    vcsh awscli push
status   = vcsh awscli status
gc       = vcsh awscli gc
fixups =
    chmod +x "$HOME/.aws/op-credential-process"
    mkdir -p "$HOME/.aws/op-session-cache" && chmod 700 "$HOME/.aws/op-session-cache"

